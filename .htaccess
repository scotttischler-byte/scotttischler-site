# ============================================================
#  scotttischler.com — canonical, HTTPS, and domain redirects
#  Upload this file to your web root alongside index.html.
#  (In cPanel File Manager, enable "Show Hidden Files" to see it.)
# ============================================================

RewriteEngine On

# --- Force HTTPS everywhere ---
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Redirect the alternate domains to the primary (scotttischler.com) ---
# Works when scottrtischler.com and scottryantischler.com are pointed at
# this same hosting (added as Alias/Parked domains in cPanel).
RewriteCond %{HTTP_HOST} ^(www\.)?scottrtischler\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?scottryantischler\.com$ [NC]
RewriteRule ^ https://scotttischler.com%{REQUEST_URI} [L,R=301]

# --- Canonicalize www -> non-www on the primary domain ---
RewriteCond %{HTTP_HOST} ^www\.scotttischler\.com$ [NC]
RewriteRule ^ https://scotttischler.com%{REQUEST_URI} [L,R=301]

# --- Default document ---
DirectoryIndex index.html

# --- Make sure PDFs and text discovery files serve with correct types ---
AddType application/pdf .pdf
AddType text/plain .txt
AddType application/xml .xml

# --- Light caching for static assets (optional, speeds repeat visits) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
  ExpiresByType text/html "access plus 1 day"
</IfModule>
